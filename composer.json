{
    "name": "infrangible/m2-payment-rules",
    "description": "Shows or hides payment methods in the checkout based on rules with conditions on customer data, address data or login status.",
    "type": "magento2-module",
    "version": "1.1.2",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Payment",
        "Cart and checkout",
        "Customers",
        "payment method rules",
        "hide payment methods by customer group",
        "conditional payment methods"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-payment-rules",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~102.3.5|~103.0.0",
        "infrangible/m2-backend-widget": "~2.7.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\PaymentRules\\": "src"
        }
    }
}
